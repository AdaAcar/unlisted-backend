# Copy to .env.local for local development. Never commit a real .env file.

# Primary database connection string (runtime).
DATABASE_URL=postgres://unlisted:unlisted@localhost:5433/unlisted_test

# RLS-subject application role. Created by db/migrations/0002_rls.sql.
APP_DATABASE_URL=postgres://unlisted_app:unlisted_app@localhost:5433/unlisted_test

# BYPASSRLS role for the explicitly named db/admin module only.
ADMIN_DATABASE_URL=postgres://unlisted_admin:unlisted_admin@localhost:5433/unlisted_test

# Database for the integration test suite. Matches docker-compose.yml.
# Required to run tests/integration/* — those tests fail, not skip, without it.
TEST_DATABASE_URL=postgres://unlisted:unlisted@localhost:5433/unlisted_test
