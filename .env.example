# Copy to .env.local for local development. Never commit a real .env file.

# One-time bootstrap / migration connection. In deployment this is a
# cluster-privileged, secret-backed identity; future migrations authenticate as
# a deployer and SET ROLE unlisted_migrator.
DATABASE_URL=postgres://<bootstrap-or-deployer-login>:<secret>@<host>:5432/<database>

# Secret-backed NOINHERIT runtime login. withActor uses SET LOCAL ROLE
# unlisted_app inside each transaction.
APP_DATABASE_URL=postgres://<application-login>:<secret>@<host>:5432/<database>

# Secret-backed NOINHERIT admin login. The named admin executor uses SET LOCAL
# ROLE unlisted_admin; the capability role is NOBYPASSRLS and read-only.
ADMIN_DATABASE_URL=postgres://<admin-login>:<secret>@<host>:5432/<database>

# Database for the integration test suite. Matches docker-compose.yml.
# Required to run tests/integration/* — those tests fail, not skip, without it.
TEST_DATABASE_URL=postgres://unlisted:unlisted@localhost:5433/unlisted_test

# Integration tests create separate random-password application/admin/deployer
# logins after migrations and set APP_DATABASE_URL / ADMIN_DATABASE_URL in-process.
